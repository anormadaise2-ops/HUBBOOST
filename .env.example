# ==========================================
# HUBBOOST - ENVIRONMENT
# ==========================================

# Serveur
FLASK_ENV=production
HOST=0.0.0.0
PORT=5000

# URL publique du site
PUBLIC_URL=https://anormadaise2-ops.github.io/HUBBOOST

# ==========================================
# SESSION / SECURITY
# ==========================================

SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# ==========================================
# DISCORD OAUTH
# ==========================================

DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://127.0.0.1:5000/api/auth/discord/callback

# ==========================================
# GITHUB OAUTH
# ==========================================

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://127.0.0.1:5000/api/auth/github/callback

# ==========================================
# DATABASE
# ==========================================

DATABASE_URL=sqlite:///hubboost.db

# ==========================================
# FORUM
# ==========================================

FORUM_ENABLED=true
MAX_POST_LENGTH=10000
MAX_TOPIC_TITLE_LENGTH=120
